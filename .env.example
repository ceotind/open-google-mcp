# Required: Google Ads Developer Token
# Get yours from https://ads.google.com/ → Tools → API Center
GOOGLE_ADS_DEVELOPER_TOKEN="your_developer_token_here"

# Optional: Manager account ID (for MCC accounts managing sub-accounts)
# The server will auto-route queries to child accounts when this is set
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# Optional: Default customer_id for Keyword Planner tools
# (generate_keyword_ideas / historical / forecast). When the tools are called
# without a customer_id they fall back to this, then to LOGIN_CUSTOMER_ID.
GOOGLE_ADS_DEFAULT_CUSTOMER_ID=""

# Optional: GCP Project ID

# --- Authentication ---
#
# Service account (recommended — works for both Google Ads and Search Console):
#   1. Create a service account in GCP Console → APIs & Services → Credentials
#   2. Enable Google Ads API + Search Console API in the API Library
#   3. Add the service account email as a user in your Google Ads manager account
#      (Settings → Account access → Service account users)
#   4. Add the same email to your Search Console property
#      (Settings → Users and permissions → Add user)
#   5. Fill in the fields below (values from the downloaded JSON key file):
# GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
# GOOGLE_SERVICE_ACCOUNT_KEY_ID="your_private_key_id"
# GOOGLE_SERVICE_ACCOUNT_KEY='-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n'
# GOOGLE_SERVICE_ACCOUNT_CLIENT_ID="your_client_id"
# GOOGLE_SERVICE_ACCOUNT_PROJECT_ID="your_project_id"
#
# Alternatively, you can use a local JSON key file:
# GOOGLE_ADS_JSON_KEY_FILE="/path/to/service_account_key.json"

# --- Google Analytics 4 (GA4) ---
# The same service account (GOOGLE_SERVICE_ACCOUNT_*) is used for auth.
# Add the service account email to your GA4 property:
#   Admin → Account Access Management → Add user → Viewer
#
# Optional: Dedicated GA4 credential file path (overrides GOOGLE_ADS_JSON_KEY_FILE)
# GA4_CREDENTIALS_PATH=""

# --- Alternative: OAuth (if you prefer) ---
# GOOGLE_ADS_REFRESH_TOKEN="your_refresh_token"
# GOOGLE_ADS_CLIENT_ID="your_client_id"
# GOOGLE_ADS_CLIENT_SECRET="your_client_secret"

# --- Bing Webmaster Tools ---
# Read-only site, query, crawl, and link data from Bing.
# Get the key from Bing Webmaster Tools:
#   1. Sign in at https://www.bing.com/webmasters
#   2. Verify your site
#   3. Settings -> API Access -> Generate API Key
# One key covers all sites verified in that account.
BING_WEBMASTER_API_KEY=""

# Optional: override the response cache (seconds). Bing updates query data weekly.
# BING_CACHE_TTL="300"

# Optional: HTTP request timeout (seconds).
# BING_REQUEST_TIMEOUT="30"
