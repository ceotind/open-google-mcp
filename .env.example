# Required: Google Ads Developer Token
# Get yours from https://ads.google.com/ → Tools → API Center
GOOGLE_ADS_DEVELOPER_TOKEN="your_developer_token_here"

# Optional: Manager account ID (for MCC accounts managing sub-accounts)
# The server will auto-route queries to child accounts when this is set
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# Optional: GCP Project ID
GOOGLE_PROJECT_ID=""

# --- Authentication (pick one method) ---

# Method A: Application Default Credentials (recommended)
# Run `gcloud auth application-default login` to set up credentials
# No additional env vars needed.

# Method B: OAuth refresh token
# GOOGLE_ADS_REFRESH_TOKEN="your_refresh_token"
# GOOGLE_ADS_CLIENT_ID="your_client_id"
# GOOGLE_ADS_CLIENT_SECRET="your_client_secret"

# --- Google Search Console Authentication ---
# If you already have GOOGLE_ADS_CLIENT_ID and GOOGLE_ADS_CLIENT_SECRET set
# (above), the GSC tools will reuse them automatically — no additional
# env vars needed here. Just ensure the Search Console API is enabled in
# your GCP project and the OAuth consent screen includes the scope:
#   https://www.googleapis.com/auth/webmasters.readonly
#
# On first use, a browser window opens for you to authorize the GSC scope.

# Alternatively, you can use a dedicated OAuth client secrets file:
# GSC_OAUTH_CLIENT_SECRETS_FILE="/path/to/client_secrets.json"

# Or a service account (headless/automated environments):
# GSC_CREDENTIALS_PATH="/path/to/service_account_key.json"
